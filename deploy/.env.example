# Copy this file to deploy/.env before running Docker Compose.
# Never commit deploy/.env or put real credentials in deploy/.env.example.

# ---------------------------------------------------------------------------
# 1. SQL Server
# ---------------------------------------------------------------------------
HKSHOP_APP_CONNECTION=Server=sql,1433;Database=HKShopLocal;User ID=sa;Password=272991;Encrypt=True;TrustServerCertificate=True

# ---------------------------------------------------------------------------
# 2. Public Hostname (Option 2: Free HTTPS Tunnel when you don't own a domain)
# ---------------------------------------------------------------------------
# Paste only the host (no https:// and no trailing /).
HKSHOP_HOSTNAME=replace-with-your-tunnel.trycloudflare.com

# ---------------------------------------------------------------------------
# 3. Initial Admin Bootstrap (run --bootstrap-admin once, then clear password)
# ---------------------------------------------------------------------------
HKSHOP_ADMIN_EMAIL=admin@example.test
# Minimum 10 characters:
HKSHOP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 4. SePay Sandbox (optional; from https://my.sepay.vn -> Cong thanh toan -> Sandbox)
# ---------------------------------------------------------------------------
HKSHOP_SEPAY_MERCHANT_ID=
HKSHOP_SEPAY_MERCHANT_SECRET=
HKSHOP_SEPAY_IPN_SECRET=

# ---------------------------------------------------------------------------
# 5. Product Images on S3-Compatible Storage (leave HKSHOP_S3_BUCKET blank for local volume)
# ---------------------------------------------------------------------------
HKSHOP_S3_SERVICE_URL=
HKSHOP_S3_REGION=auto
HKSHOP_S3_BUCKET=
HKSHOP_S3_ACCESS_KEY=
HKSHOP_S3_SECRET_KEY=
HKSHOP_S3_KEY_PREFIX=products
HKSHOP_S3_PUBLIC_BASE_URL=
HKSHOP_S3_FORCE_PATH_STYLE=true

# Kafka for checkout. Change the host port if another Docker broker uses 9092.
# HKSHOP_KAFKA_PORT=9092
# HKSHOP_KAFKA_CHECKOUT_TOPIC=hkshop.checkout.requests.v1
# HKSHOP_KAFKA_CHECKOUT_GROUP_ID=hkshop.checkout.v1

# Seq structured log server (UI and local ingestion).
# HKSHOP_SEQ_PORT=5341
# HKSHOP_SEQ_API_KEY=

# HKShop transportation pilot
HKSHOP_TRANSPORT_ENABLED=false
HKSHOP_TRANSPORT_ROUTING_BASE_URL=
HKSHOP_TRANSPORT_BANK_NAME=
HKSHOP_TRANSPORT_BANK_ACCOUNT=
HKSHOP_TRANSPORT_BANK_WEBHOOK_KEY=
