@page "/eoffice/sellers"
@layout EOfficeLayout
@attribute [Authorize(Policy = ShopPolicies.EOfficeAdmin)]
@inject ICommerceOperationsPort Commerce
@inject IStoreApplicationReview Applications
@inject IShopRequestContext Request

<PageTitle>Store management · HKShop EOffice</PageTitle>
<h1>Store</h1>

@if (applications is not null)
{
    <section class="panel">
        <h2>Store applications</h2>
        @if (applications.Total == 0)
        {
            <p>No store applications yet.</p>
        }
        <ul class="clean-list">
            @foreach (var application in applications.Items)
            {
                <li>
                    <a href="@($"/eoffice/sellers/applications/{application.Id:D}")">@application.StoreName</a>
                    <span>@application.Status · @ShopDisplay.Date(application.SubmittedAt)</span>
                </li>
            }
        </ul>
        <Pager Current="applications.Number" Last="applications.Last" Url="ApplicationUrl" />
    </section>
}

@if (sellers is not null)
{
    <section class="panel">
        <h2>Store registrations and status</h2>
        @if (sellers.Total == 0)
        {
            <p>No stores registered yet.</p>
        }
        @foreach (var seller in sellers.Items)
        {
            <details class="editor">
                <summary>@seller.DisplayName <span class="status">@ShopDisplay.Status(seller.Status)</span></summary>
                <p>Store slug <strong>@seller.Slug</strong></p>
                @if (seller.Id == 1)
                {
                    <p class="muted">HKShop store</p>
                }
                else if (seller.Status != SellerStatus.Closed)
                {
                    <p class="muted">@seller.OwnerEmail · Registered @ShopDisplay.Date(seller.CreatedAt)</p>
                    var active = seller.Status == SellerStatus.Active;
                    var nextStatus = active ? SellerStatus.Suspended : SellerStatus.Active;
                    var action = seller.Status switch
                    {
                        SellerStatus.Active => "Suspend store",
                        _ => "Restore store"
                    };
                    <form class="form-stack narrow" method="post" action="@($"/api/eoffice/sellers/{seller.Id}/status")">
                        <AntiforgeryToken />
                        <input name="status" type="hidden" value="@nextStatus" />
                        <label>
                            @(active ? "Suspension reason" : "Reason (optional)")
                            <input name="reason" maxlength="250" required="@active" />
                        </label>
                        <button class="button secondary" type="submit">@action</button>
                    </form>
                }
            </details>
        }
        <Pager Current="sellers.Number" Last="sellers.Last" Url="PageUrl" />
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "page")] public int? Number { get; set; }
    [SupplyParameterFromQuery(Name = "applications")] public int? ApplicationPage { get; set; }
    private Page<PlatformSeller>? sellers;
    private Page<StoreApplicationSummary>? applications;

    protected override async Task OnParametersSetAsync()
    {
        var actor = await Request.Actor();
        sellers = await Commerce.PlatformSellersAsync(actor, Number ?? 1);
        applications = await Applications.Queue(actor, ApplicationPage ?? 1);
    }

    private string PageUrl(int page) => $"/eoffice/sellers?page={page}&applications={ApplicationPage ?? 1}";
    private string ApplicationUrl(int page) => $"/eoffice/sellers?page={Number ?? 1}&applications={page}";
}
