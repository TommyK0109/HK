@page "/eoffice/inventory"
@layout EOfficeLayout
@attribute [Authorize(Policy = ShopPolicies.EOfficeStaff)]
@inject ICatalogOperationsPort Catalog
@inject IShopRequestContext Request

<PageTitle>Inventory management · HKShop EOffice</PageTitle>
<h1>Inventory management</h1>
<nav class="section-nav" aria-label="Inventory filters">
    <a href="/eoffice/inventory">All SKUs</a><a href="/eoffice/inventory?low=true">Low stock</a>
</nav>
@if (rows is not null)
{
    @if (rows.Items.Count == 0) { <div class="empty-state"><p>No matching SKUs found.</p></div> }
    @foreach (var row in rows.Items)
    {
        <details class="editor panel" open="@(Sku == row.SkuId)">
            <summary>@row.Code · @row.Product · Available @row.Available · Marketplace available @row.TotalOfferAvailable</summary>
            <p class="muted">1P On hand @row.OnHand · 1P Reserved @row.Reserved · Marketplace on hand @row.TotalOfferOnHand · Marketplace available @row.TotalOfferAvailable</p>
            <form class="form-stack" method="post" action="/api/eoffice/inventory/stock">
                <AntiforgeryToken /><input type="hidden" name="skuId" value="@row.SkuId" />
                <div class="form-columns">
                    <label>Stock adjustment <input name="delta" type="number" step="1" value="0" required /></label>
                    <label>Low-stock threshold <input name="threshold" type="number" step="1" min="0" value="@row.LowThreshold" required /></label>
                </div>
                <label>Reason <input name="reason" maxlength="250" required /></label>
                <button class="button secondary" type="submit">Update stock</button>
            </form>
            @if (Sku != row.SkuId)
            {
                <a class="back top-space" href="@HistoryUrl(row.SkuId)">View history</a>
            }
        </details>
    }
    <Pager Current="rows.Number" Last="rows.Last" Url="PageUrl" />
}
@if (Sku is not null)
{
    <section class="panel top-space">
        <h2>Inventory history</h2>
        @if (history.Count == 0) { <p>No changes yet.</p> }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th scope="col">Time</th><th scope="col">On hand</th><th scope="col">Reserved</th><th scope="col">Reason</th></tr></thead>
                <tbody>
                    @foreach (var item in history)
                    {
                        <tr><td>@ShopDisplay.Date(item.OccurredAt)</td><td>@item.OnHandDelta</td><td>@item.ReservedDelta</td><td>@ShopDisplay.StockReason(item.Reason)</td></tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery] public bool Low { get; set; }
    [SupplyParameterFromQuery] public long? Sku { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? Number { get; set; }
    private Page<StockRow>? rows;
    private IReadOnlyList<StockMovementDto> history = [];

    protected override async Task OnParametersSetAsync()
    {
        var actor = await Request.Actor();
        rows = await Catalog.ListFirstPartyStockAsync(actor, Low, Number ?? 1);
        if (Sku is not null) history = await Catalog.FirstPartyHistoryAsync(actor, Sku.Value);
    }

    private string PageUrl(int page) => $"/eoffice/inventory?low={Low.ToString().ToLowerInvariant()}&page={page}";
    private string HistoryUrl(long id) => $"{PageUrl(rows?.Number ?? 1)}&sku={id}";
}
