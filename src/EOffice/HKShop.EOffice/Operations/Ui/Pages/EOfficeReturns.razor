@page "/eoffice/returns"
@layout EOfficeLayout
@attribute [Authorize(Policy = ShopPolicies.EOfficeStaff)]
@inject ICommerceOperationsPort Commerce
@inject IShopRequestContext Request

<PageTitle>Returns · HKShop EOffice</PageTitle>
<h1>Returns</h1>
@if (queue.Count == 0)
{
    <div class="empty-state"><p>No requests pending review or inspection.</p></div>
}
else
{
    <div class="table-wrap"><table>
        <thead><tr><th scope="col">Submitted</th><th scope="col">Status</th><th scope="col">Reason</th><th scope="col">Order</th></tr></thead>
        <tbody>
            @foreach (var row in queue)
            {
                <tr><td>@ShopDisplay.Date(row.RequestedAt)</td><td>@ShopDisplay.Status(row.Status)</td><td>@row.Reason</td>
                    <td><a href="@($"/eoffice/orders/{row.OrderId}#return-{row.Id}")">Process</a></td></tr>
            }
        </tbody>
    </table></div>
}

@code {
    private IReadOnlyList<EOfficeReturnDto> queue = [];
    protected override async Task OnInitializedAsync()
    {
        var actor = await Request.Actor();
        queue = await Commerce.ReturnQueueAsync(actor);
    }
}
